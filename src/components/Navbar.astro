---
import navigation from "../config/navigation";

const pathname = Astro.url.pathname;
---

<div class="top-container">
    <nav class="navbar navbar-expand-md bg-card">
        <div class="container-fluid">
            <a href="/" class="navbar-brand">mirror.nekoha.moe</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-content" aria-controls="navbar-content" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbar-content">
                <ul class="navbar-nav w-100">
                    {navigation.map((item) =>
                        item.children ? (
                            <li class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    {item.title}
                                </a>

                                <ul class="dropdown-menu">
                                    {item.children.map((child) => (
                                        <li>
                                            <a
                                                href={child.url}
                                                class:list={[
                                                    "dropdown-item",
                                                    { active: pathname === child.url }
                                                ]}
                                            >
                                                {child.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        ) : (
                            <li class="nav-item">
                                <a
                                    href={item.url}
                                    class:list={[
                                        "nav-link",
                                        { active: pathname === item.url }
                                    ]}
                                >
                                    {item.title}
                                </a>
                            </li>
                        )
                    )}
                </ul>
            </div>
        </div>
    </nav>

    <div class="bg-danger w-100 p-2 text-center d-none">
        <span class="text-white fw-bold">API is temporarily offline due to maintenance</span>
    </div>
</div>